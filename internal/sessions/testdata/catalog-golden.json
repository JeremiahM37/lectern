    "prompt_arg": true,
    "trust_command": "python3 - {dir} \u003c\u003c'ADKTRUST'\nimport json, os, sys, tempfile\nconfig = os.environ.get(\"OPENCLAUDE_CONFIG_DIR\")\npath = os.path.join(os.path.expanduser(config), \".openclaude.json\") if config else os.path.expanduser(\"~/.openclaude.json\")\nos.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)\ntry:\n    with open(path) as f:\n        doc = json.load(f)\nexcept Exception:\n    doc = {}\nentry = doc.setdefault(\"projects\", {}).setdefault(sys.argv[1], {})\nif entry.get(\"hasTrustDialogAccepted\") is not True:\n    entry[\"hasTrustDialogAccepted\"] = True\n    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or \".\")\n    with os.fdopen(fd, \"w\") as f:\n        json.dump(doc, f, indent=2)\n    os.replace(tmp, path)\nADKTRUST",
    "yolo_args": [
      "--dangerously-skip-permissions"
    ],
    "task": {
      "args": [
        "--output-format",
        "stream-json",
        "--verbose"
      ],
