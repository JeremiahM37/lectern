<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed because the address is the owner's choice: a
     tailnet address (already encrypted by WireGuard), a LAN host, or the
     emulator's 10.0.2.2. The encrypted relay does not depend on this: its
     traffic is end-to-end encrypted whatever the transport. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
