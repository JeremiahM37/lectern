# systemd unit for bare-metal installs (recommended on the homelab).
#   go build -o /usr/local/bin/lectern ./cmd/lectern
#   sudo cp deploy/lectern.service /etc/systemd/system/
#   sudo systemctl enable --now lectern
[Unit]
Description=lectern — mission control for AI coding agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/projects/lectern
# Agent processes and their tmux sessions are durable work, not service
# plumbing. Keep descendants alive across a control-plane upgrade; graceful
# shutdown closes terminal proxies and stops scheduling before the main process
# exits, and the next process adopts surviving sessions from SQLite. This does
# not govern SSH, PCT, or sandbox targets, whose processes live on the target.
KillMode=process
# URL that TARGETS use to reach this server for approval callbacks
Environment=LECTERN_BASE_URL=http://YOUR-SERVER-IP:9110
# Agent binaries often live in ~/.local/bin, which is NOT on a unit's default
# PATH — a probe reporting "codex: null" for an installed codex means this.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/admin/.local/bin
ExecStart=/usr/local/bin/lectern
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
